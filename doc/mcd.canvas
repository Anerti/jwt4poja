		{"id":"d6f75ca4438cf96f","type":"text","text":"# course\n\n- `id uuid pk default gen_random_uuid()`\n- `ref varchar(10) unique not null`\n- `title text`\n- `type enum('EL', 'TN', 'COMMON') default 'COMMON'`\n- `credits int not null`\n- `created_at timestampz default now()`\n- `updated_at timestampz`","x":-1337,"y":-1153,"width":710,"height":329,"color":"#dea311"},
